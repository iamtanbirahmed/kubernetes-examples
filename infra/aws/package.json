{
  "name": "@kubernetes-examples/aws",
  "version": "0.1.0",
  "bin": {
    "aws": "bin/aws.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "infra/aws"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run cdk doctor",
          "cwd": "infra/aws"
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run cdk deploy",
          "cwd": "infra/aws"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run test",
          "cwd": "infra/aws"
        }
      },
      "destroy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run cdk destroy",
          "cwd": "infra/aws"
        }
      },
      "diff": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run cdk diff",
          "cwd": "infra/aws"
        }
      },
      "bootstrap": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run cdk bootstrap",
          "cwd": "infra/aws"
        }
      },
      "synth": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run cdk synth",
          "cwd": "infra/aws"
        }
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1033.0",
    "cdk-nag": "^2.37.55",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.215.0",
    "constructs": "^10.0.0"
  }
}
